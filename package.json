{
  "name": "obsidian-apple-reminders-plus",
  "version": "1.0.0",
  "description": "Apple Reminders Plus sidebar plugin for Obsidian",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "Isaque Pereira",
    "url": "https://github.com/isaquepereira"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isaquepereira/obsidian-apple-reminders-plus.git"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
